---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import PageTransition from '../components/sections/PageTransition.astro';
import ProjectShowcase from '../components/sections/ProjectShowcase.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Stack from '../components/sections/Stack.astro';
import Footer from '../components/layout/Footer.astro';
import ToastHost from '../components/islands/ToastHost.vue';
---

<Layout
	title="Astro Vue — Landing"
	description="Digital product design and development — strategies, UX, and AI-powered technology for growth."
	navSurface="light"
>
	<ToastHost client:idle />
	<main id="main" class="overflow-x-clip">
		<Hero />
		<PageTransition />
		<ProjectShowcase />
		<HowItWorks />
		<Stack />
	</main>
	<Footer />
</Layout>
