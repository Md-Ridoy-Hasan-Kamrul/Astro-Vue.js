---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Stack from '../components/sections/Stack.astro';
import Footer from '../components/layout/Footer.astro';
import ToastHost from '../components/islands/ToastHost.vue';
---

<Layout title="Astro Vue — Landing" navSurface="dark">
	<ToastHost client:idle />
	<main id="main" class="overflow-x-clip">
		<Hero />
		<Features />
		<HowItWorks />
		<Stack />
	</main>
	<Footer />
</Layout>
