---
/**
 * Stack section — static shell + Interactive Book island.
 * Skills content lives here; only the book hydrates (`client:visible`).
 */
import InteractiveBook from '../islands/InteractiveBook.vue';

const BOOK_WIDTH = 400;
const BOOK_HEIGHT = 600;

const skillPages = [
	{
		title: 'Frontend Development',
		eyebrow: 'UI',
		items: [
			'React.js',
			'Next.js',
			'TypeScript',
			'JavaScript (ES6+)',
			'HTML5',
			'CSS3',
			'Tailwind CSS',
			'React Router',
			'Responsive Design',
			'Component-Based Architecture',
		],
	},
	{
		title: 'State Management & API Integration',
		eyebrow: 'Data',
		items: ['REST APIs', 'Axios', 'Redux', 'TanStack Query', 'Zustand', 'Postman'],
	},
	{
		title: 'Performance, Accessibility & Testing',
		eyebrow: 'Quality',
		items: [
			'Lighthouse',
			'Web Performance Optimization',
			'Accessibility',
			'SEO',
			'Cross-Browser Compatibility',
			'Unit Testing (Jest)',
		],
	},
	{
		title: 'Tools, Build & Deployment',
		eyebrow: 'Ops',
		items: [
			'Git',
			'GitHub',
			'Vite',
			'Webpack',
			'Figma',
			'Vercel',
			'Coolify',
			'Railway',
			'CI/CD',
		],
	},
	{
		title: 'Soft Skills & Methodologies',
		eyebrow: 'Work',
		items: [
			'Problem-Solving',
			'Agile',
			'Team Collaboration',
			'Communication',
			'Client Requirement Analysis',
		],
	},
];
---

<section
	id="stack"
	class="mx-auto w-[min(100%-2rem,72rem)] py-14 md:py-20"
	aria-labelledby="stack-title"
>
	<p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.14em] text-sea">
		Stack
	</p>
	<h2
		id="stack-title"
		class="mb-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold tracking-tight text-ink"
	>
		Skills in five pages
	</h2>
	<p class="mb-8 max-w-xl text-[clamp(1rem,2.8vw,1.125rem)] text-ink-soft">
		Flip through the interactive book for frontend, APIs, quality, tooling, and soft skills.
	</p>

	<div
		class="overflow-x-clip overflow-y-visible rounded-[1.25rem] border border-line bg-mist/40 px-3 py-8 min-[425px]:px-4 min-[425px]:py-10 min-[720px]:px-10 min-[720px]:py-12"
	>
		<div class="mx-auto w-full max-w-[52rem]">
			<InteractiveBook
				client:visible
				pages={skillPages}
				coverTitle="Skills"
				coverSubtitle="Frontend · APIs · Quality · Tools · Soft skills"
				backTitle="That's the stack"
				backSubtitle="Click once more to close the book"
				width={BOOK_WIDTH}
				height={BOOK_HEIGHT}
			/>
		</div>
		<p class="mt-6 text-center text-sm text-ink-soft min-[720px]:mt-8">
			Click the book to open and turn pages
		</p>
	</div>
</section>
