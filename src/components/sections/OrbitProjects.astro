---
/**
 * Orbit projects — Framer "OrbitProject" port:
 * https://framer.com/m/OrbitProject-9wzRp1.js@PjYJYM0UOVDHnPEXbdIB
 *
 * Below 1024px the Framer component shows a plain grid, so that part is
 * static HTML. The scroll-driven orbit only hydrates on desktop.
 */
import OrbitProjectsStage from '../islands/OrbitProjectsStage.vue';
import OrbitFlipCard from '../ui/OrbitFlipCard.vue';
import { ORBIT_COPY, ORBIT_ITEMS, ORBIT_MEDIA_QUERY, orbitCssVars } from '../../lib/orbit/orbitProjects';
---

<section
	id="orbit-projects"
	class="orbit-section relative w-full"
	aria-label={ORBIT_COPY.sectionLabel}
	style={orbitCssVars()}
>
	<div data-orbit-desktop class="hidden min-[1024px]:block">
		<OrbitProjectsStage items={ORBIT_ITEMS} client:media={ORBIT_MEDIA_QUERY} />
	</div>

	<div data-orbit-compact class="orbit-compact min-[1024px]:hidden">
		<header class="orbit-compact__header">
			<h2 class="orbit-compact__title">
				<span class="block">{ORBIT_COPY.leftTitle}</span>
				<span class="block">{ORBIT_COPY.rightTitle}</span>
			</h2>
			<p class="orbit-compact__copy">{ORBIT_COPY.centerText}</p>
		</header>
		<div data-orbit-grid class="orbit-compact__grid">
			{
				ORBIT_ITEMS.map((item) => (
					<div class="orbit-compact__card">
						<OrbitFlipCard item={item} client:visible />
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.orbit-section {
		background: var(--orbit-bg);
		color: var(--orbit-ink);
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
	}

	.orbit-compact {
		box-sizing: border-box;
		width: 100%;
		padding: var(--orbit-pad-y) var(--orbit-pad-x);
	}

	.orbit-compact__header {
		margin-bottom: var(--orbit-header-gap);
	}

	.orbit-compact__title {
		margin: 0;
		font-size: var(--orbit-compact-title);
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: -0.065em;
		text-align: left;
	}

	.orbit-compact__copy {
		max-width: var(--orbit-copy-width);
		margin: var(--orbit-copy-gap) 0 0;
		font-size: 12px;
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: -0.035em;
		text-align: left;
	}

	.orbit-compact__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--orbit-grid-gap);
	}

	/* Media queries cannot read custom properties: 640px = ORBIT_LAYOUT.mobileMaxPx. */
	@media (min-width: 640px) {
		.orbit-compact__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.orbit-compact__card {
		position: relative;
		width: 100%;
		aspect-ratio: var(--orbit-card-aspect);
	}
</style>
