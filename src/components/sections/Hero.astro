---
import TrustedByMarquee from '../islands/TrustedByMarquee.vue';
import HeroGlassyOrb from './HeroGlassyOrb.astro';
---

<section
	id="top"
	class="relative isolate bg-[#f4f5f7] text-ink"
	aria-labelledby="hero-heading"
>
	<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
		<div
			class="absolute top-[-18%] left-[-12%] h-[52vmin] w-[52vmin] rounded-full bg-[#60B1FF]/35 blur-[110px]"
		>
		</div>
		<div
			class="absolute top-[-6%] left-[8%] h-[36vmin] w-[36vmin] rounded-full bg-[#319AFF]/28 blur-[90px]"
		>
		</div>
	</div>

	<div class="relative z-10 mx-auto w-[min(100%-2rem,72rem)] pt-[clamp(6.5rem,14vw,8.5rem)] pb-10 sm:pb-14">
		<div class="relative grid w-full min-w-0 items-center gap-6 max-[320px]:grid-cols-[minmax(0,1fr)] md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] md:gap-x-8 md:gap-y-0 min-[1020px]:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] min-[1020px]:gap-x-12 min-[90rem]:grid-cols-2">
			<div class="relative z-10 min-w-0 max-w-xl max-[320px]:max-w-full md:max-w-none min-[90rem]:max-w-136">
				<h1
					id="hero-heading"
					class="font-display text-[clamp(2.15rem,5.2vw,3.65rem)] leading-[0.86] font-extrabold min-[90rem]:leading-[1.1] tracking-[-0.065em] text-ink"
				>
					Digital Product Design & Development Company
				</h1>
				<p class="mt-5 max-w-136 text-[clamp(1rem,2.2vw,1.125rem)] leading-relaxed text-ink-soft">
					We transform complex business challenges into digital strategies, innovative user experiences,
					AI-powered solutions, and technology built to drive exponential growth.
				</p>

				<div class="mt-8 flex flex-wrap items-center gap-5">
					<a
						href="/contact"
						class="inline-flex items-center justify-center rounded-full bg-ink px-7 py-3 text-[0.95rem] font-semibold text-paper transition hover:bg-ink/90 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-sea"
					>
						Contact Us
					</a>

					<div class="flex items-center gap-2.5" aria-label="4.9 rating based on 48 Clutch reviews">
						<span
							class="grid size-8 place-items-center rounded-md bg-[#163239] text-sm font-bold text-paper"
							aria-hidden="true"
						>
							C
						</span>
						<div class="leading-tight">
							<div class="flex items-center gap-1.5">
								<span class="text-[0.95rem] font-bold text-ink">4.9</span>
								<span class="flex gap-0.5 text-[#E11D48]" aria-hidden="true">
									{
										Array.from({ length: 5 }).map(() => (
											<svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor">
												<path d="M10 1.5l2.4 5.2 5.6.6-4.2 3.8 1.2 5.5L10 14.3 4.9 16.6l1.2-5.5L2 7.3l5.6-.6L10 1.5z" />
											</svg>
										))
									}
								</span>
							</div>
							<p class="text-[0.75rem] text-ink-soft">Based on 48 Clutch reviews</p>
						</div>
					</div>
				</div>
			</div>

			{/* The visible orb is 84.6% of its video frame. Tablet and laptop: the video is 107% of
			    the column, so the orb fills the column and this box (aspect 1.105) is exactly its
			    height. Desktop: the box is as tall as the orb of the scaled 30rem video. */}
			<div
				class="relative mx-auto w-full max-[426px]:-mx-4 max-[426px]:aspect-square max-[426px]:w-[calc(100%+2rem)] max-[426px]:max-w-none min-[426px]:h-[min(60vw,20rem)] min-[426px]:max-w-92 md:mx-0 md:aspect-[1.105] md:h-auto md:max-w-none min-[90rem]:aspect-auto min-[90rem]:h-full min-[90rem]:min-h-127"
			>
				<HeroGlassyOrb />
			</div>
		</div>

		<div class="border-t border-ink/5 pt-8 max-[426px]:mt-2 min-[426px]:mt-[clamp(3.5rem,10vw,6rem)] min-[426px]:pt-10 sm:pt-12">
			<TrustedByMarquee client:visible />
		</div>
	</div>
</section>
