---
/**
 * Capabilities — same six services as the reference, in this site's glass UI.
 * Hover reveal is CSS on the card, so the section stays static.
 */
import CapabilityCard from '../ui/CapabilityCard.astro';
import { CAPABILITIES, CAPABILITY_COPY } from '../../lib/capabilities/capabilities';
---

<section
	id="capabilities"
	class="relative overflow-hidden bg-[#f4f5f7] py-[clamp(4rem,9vw,6.75rem)]"
	aria-labelledby="capabilities-title"
>
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute top-[-8%] right-[-6%] h-[28rem] w-[28rem] rounded-full bg-[#60B1FF]/20 blur-[110px]">
		</div>
		<div class="absolute bottom-[-12%] left-[-8%] h-[22rem] w-[22rem] rounded-full bg-sea/15 blur-[100px]">
		</div>
	</div>

	<div class="relative mx-auto w-[min(100%-2rem,72rem)]">
		<div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
			<div class="max-w-3xl">
				<p class="font-mono text-[0.75rem] font-bold tracking-[0.16em] text-sea uppercase">
					{CAPABILITY_COPY.eyebrow}
				</p>
				<h2
					id="capabilities-title"
					class="mt-3 font-display text-[clamp(2.35rem,6vw,4.4rem)] leading-[0.96] font-extrabold tracking-tight text-ink"
				>{CAPABILITY_COPY.title}</h2>
			</div>
			<div class="flex max-w-md flex-col items-start gap-5">
				<p class="text-[1.02rem] leading-relaxed text-ink-soft">{CAPABILITY_COPY.lede}</p>
				<a
					href={CAPABILITY_COPY.contactHref}
					class="inline-flex items-center justify-center rounded-full bg-ink px-7 py-3 text-[0.95rem] font-semibold text-paper no-underline transition hover:bg-ink/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sea"
				>{CAPABILITY_COPY.contactLabel}</a>
			</div>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{CAPABILITIES.map((item) => <CapabilityCard item={item} />)}
		</div>
	</div>
</section>
