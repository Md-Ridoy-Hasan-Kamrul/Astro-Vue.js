---
/**
 * Hero glassy orb — plays /hero/orb-purple.webm exactly as authored.
 * Black plate is knocked out with mix-blend-screen; color grade matches the liquid-glass spec.
 */
import {
	ORB_COLOR_GRADE,
	ORB_SCALE,
	ORB_SOURCE_PATH,
} from '../../lib/hero/glassyOrb';
---

<div class="hero-orb" aria-hidden="true">
	<video
		class="hero-orb__video"
		data-hero-orb
		src={ORB_SOURCE_PATH}
		autoplay
		loop
		muted
		playsinline
		preload="auto"
	>
	</video>
</div>

<style define:vars={{ orbFilter: ORB_COLOR_GRADE, orbScale: ORB_SCALE }}>
	.hero-orb {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: start end;
		pointer-events: none;
		overflow: visible;
	}

	.hero-orb__video {
		display: block;
		width: min(92%, 19.5rem);
		max-width: none;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		mix-blend-mode: screen;
		transform: scale(var(--orbScale));
		transform-origin: top right;
		filter: var(--orbFilter);
	}

	@media (min-width: 40rem) {
		.hero-orb__video {
			width: min(88%, 23.5rem);
		}
	}

	@media (min-width: 64rem) {
		.hero-orb__video {
			width: min(100%, 27rem);
			translate: 14% -4%;
		}
	}

	@media (min-width: 90rem) {
		.hero-orb__video {
			width: min(100%, 29rem);
			translate: 18% -6%;
		}
	}
</style>

<script>
	const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

	function syncOrbPlayback() {
		for (const node of document.querySelectorAll('[data-hero-orb]')) {
			if (!(node instanceof HTMLVideoElement)) continue;
			node.muted = true;
			node.playsInline = true;
			if (motion.matches) {
				node.pause();
				continue;
			}
			const play = node.play();
			if (play && typeof play.catch === 'function') play.catch(() => {});
		}
	}

	syncOrbPlayback();
	document.addEventListener('astro:page-load', syncOrbPlayback);
	motion.addEventListener('change', syncOrbPlayback);
</script>
