---
/**
 * Hero glassy orb — plays /hero/orb-purple.webm exactly as authored.
 * Black plate is knocked out with mix-blend-screen; color grade matches the liquid-glass spec.
 */
import {
	ORB_COLOR_GRADE,
	ORB_SCALE,
	ORB_SOURCE_PATH,
} from '../../lib/hero/glassyOrb';
---

<div
	class="hero-orb pointer-events-none absolute inset-0 grid place-items-center overflow-visible"
	aria-hidden="true"
>
	<video
		class="hero-orb__video block aspect-square h-auto w-[min(96%,21.5rem)] max-w-none origin-[center_right] object-cover mix-blend-screen [filter:var(--orbFilter)] [transform:scale(var(--orbScale))] max-[426px]:w-[92%] max-[426px]:origin-center max-[426px]:[transform:scale(1.16)] min-[40rem]:w-[min(92%,25rem)] min-[64rem]:w-[min(100%,28.5rem)] min-[64rem]:translate-x-[18%] min-[90rem]:w-[min(100%,30rem)] min-[90rem]:translate-x-[20%]"
		data-hero-orb
		src={ORB_SOURCE_PATH}
		autoplay
		loop
		muted
		playsinline
		preload="auto"
		style={`--orbFilter: ${ORB_COLOR_GRADE}; --orbScale: ${ORB_SCALE}`}
	>
	</video>
</div>

<script>
	const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

	function syncOrbPlayback() {
		for (const node of document.querySelectorAll('[data-hero-orb]')) {
			if (!(node instanceof HTMLVideoElement)) continue;
			node.muted = true;
			node.playsInline = true;
			if (motion.matches) {
				node.pause();
				continue;
			}
			const play = node.play();
			if (play && typeof play.catch === 'function') play.catch(() => {});
		}
	}

	syncOrbPlayback();
	document.addEventListener('astro:page-load', syncOrbPlayback);
	motion.addEventListener('change', syncOrbPlayback);
</script>
