---
import FeedbackForm from '../islands/FeedbackForm.vue';
---

<section
	id="feedback"
	class="border-t border-line bg-foam/40 py-[clamp(3.5rem,8vw,6rem)]"
	aria-labelledby="feedback-title"
>
	<div class="mx-auto grid w-[min(100%-2rem,72rem)] gap-8 min-[800px]:grid-cols-[0.9fr_1.1fr] min-[800px]:items-start">
		<div>
			<p class="mb-3 font-display text-xs font-bold uppercase tracking-[0.14em] text-sea">
				Feedback
			</p>
			<h2
				id="feedback-title"
				class="mb-3 font-display text-[clamp(1.75rem,4vw,2.75rem)] font-bold leading-tight tracking-tight text-ink"
			>
				Try a real mutation
			</h2>
			<p class="m-0 max-w-xl text-lg text-ink-soft">
				Query shows loading / error / empty / cache for the live repo. The form validates
				client-side, posts with Axios + TanStack Mutation, and surfaces success or failure
				inline (plus a toast).
			</p>
		</div>

		<div class="rounded-lg border border-line bg-paper p-5 md:p-6">
			<FeedbackForm client:load />
		</div>
	</div>
</section>
