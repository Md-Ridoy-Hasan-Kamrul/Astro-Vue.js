---
/**
 * Third landing section — Ethan Vale photo archive.
 * The sticky track is tall enough to scrub an eye open, then dolly the circle.
 */
import ArchiveSphere from '../islands/ArchiveSphere.vue';
import { TRACK_HEIGHT_VH } from '../../lib/showcase/archiveSphere';
---

<section
	id="showcase"
	class="archive-track relative bg-black"
	style={`height: ${TRACK_HEIGHT_VH}vh`}
	aria-label="Project showcase"
>
	<div class="archive-pin sticky top-0 h-dvh overflow-hidden bg-[#f4f5f7]">
		<ArchiveSphere client:load />
	</div>
</section>
