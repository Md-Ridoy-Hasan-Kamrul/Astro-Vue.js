---
/**
 * Specialists — reference copy, this site's type and ink button.
 * The photo strip is a Vue island so the loop can run on its own.
 */
import SpecialistStrip from '../islands/SpecialistStrip.vue';
import { SPECIALIST_COPY, SPECIALIST_SHOTS } from '../../lib/specialists/specialists';
---

<section
	id="specialists"
	class="relative grid h-screen w-full min-w-0 max-w-full grid-cols-[minmax(0,1fr)] grid-rows-[auto_minmax(1.75rem,4.25rem)_auto] overflow-hidden border-t border-line bg-paper pt-[clamp(6.25rem,11vh,7.5rem)] pb-[clamp(1.25rem,3vh,2rem)]"
	aria-labelledby="specialists-title"
>
	<div class="mx-auto w-[min(100%-2rem,72rem)] min-w-0">
		<div class="grid items-start gap-4 lg:grid-cols-2 lg:gap-16">
			<h2
				id="specialists-title"
				class="min-w-0 font-display text-[clamp(1.7rem,4.2vw,3.6rem)] leading-[0.96] font-extrabold tracking-tight text-ink"
			>
				{SPECIALIST_COPY.titleLead}<br />{SPECIALIST_COPY.titleTail}
			</h2>
			<div class="flex min-w-0 max-w-xl flex-col items-start gap-3 lg:gap-4">
				{
					SPECIALIST_COPY.paragraphs.map((paragraph) => (
						<p class="m-0 text-[clamp(0.875rem,1.4vw,1.02rem)] leading-snug text-ink-soft lg:leading-relaxed">{paragraph}</p>
					))
				}
				<a
					href={SPECIALIST_COPY.actionHref}
					class="mt-1 inline-flex items-center justify-center rounded-full bg-ink px-7 py-3 text-[0.95rem] font-semibold text-paper no-underline transition hover:bg-ink/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sea"
				>
					{SPECIALIST_COPY.actionLabel}
				</a>
			</div>
		</div>
	</div>

	<div aria-hidden="true"></div>

	<div class="w-full min-w-0 max-w-full overflow-hidden">
		<SpecialistStrip client:visible shots={SPECIALIST_SHOTS} />
	</div>
</section>
