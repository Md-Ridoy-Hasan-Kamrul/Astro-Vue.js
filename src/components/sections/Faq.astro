---
/**
 * FAQ — dark list, orange open card, hover on desktop and tap on small screens.
 */
import FaqList from '../islands/FaqList.vue';
import { FAQ_COPY, FAQ_ITEMS } from '../../lib/faq/faq';
---

<section id="faq" class="bg-[#0a0a0a]" aria-labelledby="faq-title">
	<FaqList
		client:visible
		title={FAQ_COPY.title}
		searchPlaceholder={FAQ_COPY.searchPlaceholder}
		emptyMessage={FAQ_COPY.emptyMessage}
		items={FAQ_ITEMS}
	/>
</section>
