---
/**
 * Partner teaser — reference layout:
 * office photo height matches the right content stack (items-stretch).
 */
const officeImage = '/partner/office.jpg';
const avatarImage = '/partner/avatar.jpg';

const intro = 'Great digital products need more than good design.';

const paragraphs = [
	'Musemind brings strategy, research, design, and development together to solve business problems from every angle. We help you validate ideas, improve existing products, build new digital experiences, and create the technology behind them.',
	'From websites and mobile apps to SaaS platforms and MVPs, our teams work together from first decision to final delivery.',
] as const;
---

<section
	id="partner"
	class="relative overflow-hidden bg-paper text-ink"
	aria-labelledby="partner-heading"
>
	<div
		class="mx-auto grid w-[min(100%-2rem,72rem)] gap-8 py-[clamp(3.5rem,9vw,6.5rem)] min-[768px]:gap-10 min-[1020px]:grid-cols-2 min-[1020px]:items-stretch min-[1020px]:gap-x-12 min-[1020px]:gap-y-0"
	>
		<!-- Image height matches content column on desktop (grid stretch). -->
		<div
			class="relative aspect-[4/5] overflow-hidden min-[1020px]:aspect-auto min-[1020px]:h-full min-[1020px]:min-h-0"
		>
			<img
				src={officeImage}
				alt="Modern open office with teams collaborating at long workstations"
				class="absolute inset-0 size-full object-cover"
				loading="lazy"
				decoding="async"
				width="1200"
				height="1600"
			/>
		</div>

		<div class="flex min-w-0 flex-col">
			<h2
				id="partner-heading"
				class="font-display text-[clamp(1.85rem,4.2vw,2.75rem)] font-extrabold leading-[1.12] tracking-tight text-ink"
			>
				One Partner. From Strategy to Scale.
			</h2>

			<p class="mt-5 text-[clamp(1rem,2.1vw,1.125rem)] leading-relaxed text-ink-soft min-[768px]:mt-6">
				{intro}
			</p>

			<div class="mt-4 space-y-4 text-[clamp(0.95rem,2vw,1.0625rem)] leading-relaxed text-ink-soft">
				{paragraphs.map((text) => <p class="m-0">{text}</p>)}
			</div>

			<a
				href="/about"
				class="mt-8 inline-flex w-fit items-center justify-center rounded-full bg-ink px-7 py-3 text-[0.95rem] font-semibold text-paper no-underline transition hover:bg-ink/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sea cursor-site-pointer"
				data-astro-prefetch
			>
				More About Us
			</a>

			<figure class="mt-[clamp(2.75rem,6vw,4.25rem)]">
				<blockquote class="m-0">
					<p
						class="font-display text-[clamp(1.05rem,2.4vw,1.35rem)] font-bold leading-snug tracking-tight text-ink"
					>
						“Musemind was amazing to work with. Their design skills and tech expertise were on
						point and they really delivered.”
					</p>
				</blockquote>
				<figcaption class="mt-5 flex items-center gap-3.5">
					<img
						src={avatarImage}
						alt=""
						class="size-12 shrink-0 object-cover"
						width="48"
						height="48"
						loading="lazy"
						decoding="async"
					/>
					<div class="min-w-0 leading-snug">
						<p class="m-0 text-[0.95rem] font-bold text-ink">Nedin Zahirovic</p>
						<p class="m-0 mt-0.5 text-[0.8rem] text-ink-soft">
							Co-Founder, Konoom Software Technologies
						</p>
						<p class="m-0 text-[0.8rem] text-ink-soft">Starnberg, Germany</p>
					</div>
				</figcaption>
			</figure>
		</div>
	</div>
</section>
