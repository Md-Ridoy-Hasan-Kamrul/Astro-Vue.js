---
/**
 * One capability. On a fine pointer, hover or focus swaps the preview for the
 * description. Touch keeps both, because there is no hover.
 */
import { CAPABILITY_COPY, type Capability } from '../../lib/capabilities/capabilities';

interface Props {
	item: Capability;
}

const { item } = Astro.props;
---

<article
	data-capability-card
	class:list={[
		'group relative flex flex-col overflow-hidden rounded-[1.75rem] border border-[rgb(255_255_255/0.72)] bg-[rgb(255_255_255/0.58)] text-ink shadow-[inset_0_1px_1px_rgb(255_255_255/0.9),0_18px_40px_rgb(20_33_43/0.06)] backdrop-blur-[16px]',
		'fine:min-h-[28rem] fine:transition-[background-color,color,border-color] fine:duration-[240ms] fine:ease-[ease]',
		'fine:hover:border-transparent fine:hover:bg-sea-deep fine:hover:text-paper',
		'fine:focus-within:border-transparent fine:focus-within:bg-sea-deep fine:focus-within:text-paper',
	]}
>
	<div
		class:list={[
			'mt-[0.85rem] mx-[0.85rem] h-[13rem] overflow-hidden rounded-[1.15rem] bg-[#e7eef1]',
			'fine:absolute fine:inset-x-[0.85rem] fine:bottom-[0.85rem] fine:m-0 fine:h-[58%]',
			'fine:transition-[opacity,transform] fine:duration-[240ms] fine:ease-[ease]',
			'fine:group-hover:scale-[0.97] fine:group-hover:opacity-0',
			'fine:group-focus-within:scale-[0.97] fine:group-focus-within:opacity-0',
		]}
	>
		<img
			src={item.image}
			alt=""
			width="1200"
			height="800"
			loading="lazy"
			decoding="async"
			class="size-full object-cover object-center"
		/>
	</div>
	<div
		class:list={[
			'relative z-[1] flex flex-1 flex-col px-[1.35rem] pt-[1.1rem] pb-[1.25rem]',
			'fine:px-[1.35rem] fine:pt-[1.35rem] fine:pb-[1.15rem]',
		]}
	>
		<p
			class:list={[
				'm-0 font-mono text-[0.75rem] font-bold tracking-[0.14em] text-sea',
				'fine:transition-colors fine:duration-[240ms] fine:ease-[ease]',
				'fine:group-hover:text-foam fine:group-focus-within:text-foam',
			]}
		>
			{item.index}
		</p>
		<h3 class="mt-[0.7rem] mb-0 max-w-[16rem] font-display text-[clamp(1.45rem,2vw,1.85rem)] leading-[1.05] font-bold tracking-[-0.03em]">
			{item.title}
		</h3>
		<div
			class:list={[
				'mt-auto flex flex-col gap-[1.15rem] pt-[1.25rem]',
				'fine:pointer-events-none fine:absolute fine:inset-x-[1.35rem] fine:bottom-[1.25rem] fine:mt-0 fine:pt-0 fine:translate-y-[0.65rem] fine:opacity-0',
				'fine:transition-[opacity,transform] fine:duration-[240ms] fine:ease-[ease]',
				'fine:group-hover:pointer-events-auto fine:group-hover:translate-y-0 fine:group-hover:opacity-100',
				'fine:group-focus-within:pointer-events-auto fine:group-focus-within:translate-y-0 fine:group-focus-within:opacity-100',
			]}
		>
			<p
				class:list={[
					'm-0 text-[0.95rem] leading-[1.45] text-ink-soft',
					'fine:group-hover:text-[rgb(247_250_251/0.86)] fine:group-focus-within:text-[rgb(247_250_251/0.86)]',
				]}
			>
				{item.body}
			</p>
			<a
				class:list={[
					'self-start rounded-full bg-ink px-[1.15rem] py-[0.7rem] text-[0.9rem] leading-none font-semibold text-paper no-underline',
					'focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-solid focus-visible:outline-sea',
					'fine:transition-[background-color,color] fine:duration-[240ms] fine:ease-[ease]',
					'fine:group-hover:bg-paper fine:group-hover:text-ink',
					'fine:group-focus-within:bg-paper fine:group-focus-within:text-ink',
				]}
				href={CAPABILITY_COPY.exploreHref}
			>{CAPABILITY_COPY.exploreLabel}</a>
		</div>
	</div>
</article>
