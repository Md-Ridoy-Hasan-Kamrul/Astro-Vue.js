---
/**
 * One capability. On a fine pointer, hover or focus swaps the preview for the
 * description. Touch keeps both, because there is no hover.
 */
import { CAPABILITY_COPY, type Capability } from '../../lib/capabilities/capabilities';

interface Props {
	item: Capability;
}

const { item } = Astro.props;
---

<article data-capability-card class="cap-card">
	<div class="cap-card__media">
		<img src={item.image} alt="" width="1200" height="800" loading="lazy" decoding="async" />
	</div>
	<div class="cap-card__copy">
		<p class="cap-card__index">{item.index}</p>
		<h3 class="cap-card__title">{item.title}</h3>
		<div class="cap-card__detail">
			<p class="cap-card__body">{item.body}</p>
			<a class="cap-card__explore" href={CAPABILITY_COPY.exploreHref}>{CAPABILITY_COPY.exploreLabel}</a>
		</div>
	</div>
</article>

<style>
	.cap-card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 0.72);
		border-radius: 1.75rem;
		background: rgb(255 255 255 / 0.58);
		color: var(--color-ink);
		box-shadow:
			inset 0 1px 1px rgb(255 255 255 / 0.9),
			0 18px 40px rgb(20 33 43 / 0.06);
		backdrop-filter: blur(16px);
	}

	.cap-card__media {
		height: 13rem;
		margin: 0.85rem 0.85rem 0;
		overflow: hidden;
		border-radius: 1.15rem;
		background: #e7eef1;
	}

	.cap-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.cap-card__copy {
		position: relative;
		z-index: 1;
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.1rem 1.35rem 1.25rem;
	}

	.cap-card__index {
		margin: 0;
		color: var(--color-sea);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.cap-card__title {
		max-width: 16rem;
		margin: 0.7rem 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.45rem, 2vw, 1.85rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	.cap-card__detail {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		margin-top: auto;
		padding-top: 1.25rem;
	}

	.cap-card__body {
		margin: 0;
		color: var(--color-ink-soft);
		font-size: 0.95rem;
		line-height: 1.45;
	}

	.cap-card__explore {
		align-self: flex-start;
		border-radius: 999px;
		background: var(--color-ink);
		padding: 0.7rem 1.15rem;
		color: var(--color-paper);
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
	}

	.cap-card__explore:focus-visible {
		outline: 2px solid var(--color-sea);
		outline-offset: 3px;
	}

	@media (min-width: 640px) and (hover: hover) {
		.cap-card {
			min-height: 28rem;
		}

		.cap-card__media {
			position: absolute;
			right: 0.85rem;
			bottom: 0.85rem;
			left: 0.85rem;
			height: 58%;
			margin: 0;
		}

		.cap-card__copy {
			padding: 1.35rem 1.35rem 1.15rem;
		}

		.cap-card,
		.cap-card__media,
		.cap-card__detail,
		.cap-card__index,
		.cap-card__explore {
			transition:
				background-color 240ms ease,
				color 240ms ease,
				border-color 240ms ease,
				opacity 240ms ease,
				transform 240ms ease;
		}

		.cap-card__detail {
			position: absolute;
			right: 1.35rem;
			bottom: 1.25rem;
			left: 1.35rem;
			margin-top: 0;
			padding-top: 0;
			opacity: 0;
			transform: translateY(0.65rem);
			pointer-events: none;
		}

		.cap-card:hover,
		.cap-card:focus-within {
			border-color: transparent;
			background: var(--color-sea-deep);
			color: var(--color-paper);
		}

		.cap-card:hover .cap-card__media,
		.cap-card:focus-within .cap-card__media {
			opacity: 0;
			transform: scale(0.97);
		}

		.cap-card:hover .cap-card__index,
		.cap-card:focus-within .cap-card__index {
			color: var(--color-foam);
		}

		.cap-card:hover .cap-card__detail,
		.cap-card:focus-within .cap-card__detail {
			opacity: 1;
			transform: none;
			pointer-events: auto;
		}

		.cap-card:hover .cap-card__body,
		.cap-card:focus-within .cap-card__body {
			color: rgb(247 250 251 / 0.86);
		}

		.cap-card:hover .cap-card__explore,
		.cap-card:focus-within .cap-card__explore {
			background: var(--color-paper);
			color: var(--color-ink);
		}
	}
</style>
