---
/**
 * Meridian footer. The engraved viaduct is a background video,
 * blended into the sage paper so the page reads as one illustration.
 */
const year = new Date().getFullYear();

const links = [
	'Platform',
	'Workflows',
	'Integrations',
	'For Teams',
	'For Studios',
	'About',
	'Journal',
	'Contact',
];

const film =
	'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260928_144832_2b6b23aa-4416-4fcb-9df4-132349c59edc.mp4';
---

<footer class="footer" aria-label="Site">
	<video
		class="footer__video"
		autoplay
		muted
		loop
		playsinline
		preload="auto"
		aria-hidden="true"
		tabindex="-1"
		disablepictureinpicture
	>
		<source src={film} type="video/mp4" />
	</video>

	<div class="footer__content">
		<svg class="footer__mark" viewBox="0 0 64 64" role="img" aria-label="Meridian compass">
			<circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
			<circle cx="32" cy="32" r="25.5" fill="none" stroke="currentColor" stroke-width=".8" opacity=".5"></circle>
			<g fill="currentColor" opacity=".85">
				<path d="M32 32 L46 18 L35.2 34.4 Z"></path>
				<path d="M32 32 L46 46 L29.6 35.2 Z"></path>
				<path d="M32 32 L18 46 L28.8 29.6 Z"></path>
				<path d="M32 32 L18 18 L34.4 28.8 Z"></path>
			</g>
			<g stroke="currentColor" stroke-width="1" stroke-linejoin="round">
				<path d="M32 8 L35.5 28.5 L32 32 Z" fill="currentColor"></path>
				<path d="M32 8 L28.5 28.5 L32 32 Z" fill="none"></path>
				<path d="M56 32 L35.5 35.5 L32 32 Z" fill="currentColor"></path>
				<path d="M56 32 L35.5 28.5 L32 32 Z" fill="none"></path>
				<path d="M32 56 L28.5 35.5 L32 32 Z" fill="currentColor"></path>
				<path d="M32 56 L35.5 35.5 L32 32 Z" fill="none"></path>
				<path d="M8 32 L28.5 28.5 L32 32 Z" fill="currentColor"></path>
				<path d="M8 32 L28.5 35.5 L32 32 Z" fill="none"></path>
			</g>
			<circle cx="32" cy="32" r="1.8" fill="var(--paper)" stroke="currentColor" stroke-width="1"></circle>
		</svg>

		<p class="footer__brand">
			<a href="#" aria-label="Meridian home">meridian</a>
		</p>
		<p class="footer__tagline">
			The scenic route to shipped work. Plan, track, and deliver from town to town.
		</p>
		<nav class="footer__nav" aria-label="Footer">
			<ul>
				{
					links.map((label) => (
						<li>
							<a href="#">{label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p class="footer__copy">© <span id="year">{year}</span> Meridian Works Ltd.</p>
	</div>
</footer>

<style>
	.footer {
		--paper: #ebeee7;
		--ink: #2b3a30;
		--ink-soft: #3d4a41;
		--muted: #6b746c;
		--serif: 'Fraunces', Georgia, 'Times New Roman', serif;
		--sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;

		position: relative;
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100vh;
		height: 100svh;
		overflow: hidden;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--sans);
		isolation: isolate;
		-webkit-font-smoothing: antialiased;
	}

	.footer__video {
		position: relative;
		z-index: 0;
		display: block;
		flex: 1 1 0;
		order: 2;
		width: 100%;
		height: 100%;
		min-height: 0;
		margin-top: -12vh;
		margin-top: -12svh;
		background: var(--paper);
		object-fit: cover;
		object-position: 50% 35%;
		pointer-events: none;
		user-select: none;
		mix-blend-mode: multiply;
	}

	.footer__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex: none;
		flex-direction: column;
		align-items: center;
		order: 1;
		width: 100%;
		padding: calc(5.75rem + clamp(8px, 1vw, 16px)) 16px 0;
		text-align: center;
	}

	.footer__mark {
		display: block;
		width: clamp(44px, 4.1vw, 54px);
		height: auto;
		color: var(--ink);
	}

	.footer__brand {
		margin: clamp(6px, 0.9vw, 12px) 0 0;
		font-family: var(--serif);
		font-size: clamp(40px, 3.6vw, 48px);
		font-weight: 600;
		font-variation-settings: 'opsz' 72;
		line-height: 1;
		letter-spacing: -0.015em;
		color: var(--ink);
	}

	.footer__brand a {
		color: inherit;
		text-decoration: none;
	}

	.footer__tagline {
		max-width: 44em;
		margin: clamp(14px, 1.4vw, 18px) 0 0;
		font-size: clamp(14px, 1.1vw, 15px);
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.footer__nav {
		width: 100%;
		max-width: 100%;
		margin-top: clamp(28px, 3.2vw, 40px);
	}

	.footer__nav ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
		row-gap: 10px;
	}

	.footer__nav li {
		display: flex;
		align-items: center;
	}

	.footer__nav li + li::before {
		flex: none;
		width: 4px;
		height: 4px;
		margin: 0 clamp(16px, 1.8vw, 24px);
		content: '';
		background: var(--ink);
		border-radius: 50%;
	}

	.footer__nav a {
		position: relative;
		padding: 4px 0;
		color: var(--ink);
		font-size: clamp(14px, 1.1vw, 15px);
		font-weight: 400;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer__nav a::after {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 1px;
		content: '';
		background: currentColor;
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s ease;
	}

	.footer__nav a:hover::after,
	.footer__nav a:focus-visible::after {
		transform: scaleX(1);
	}

	.footer__nav a:focus-visible {
		border-radius: 2px;
		outline: 2px solid var(--ink);
		outline-offset: 4px;
	}

	.footer__copy {
		margin: clamp(22px, 2.4vw, 30px) 0 0;
		font-size: 11.5px;
		letter-spacing: 0.01em;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.footer__nav ul {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			row-gap: 4px;
			column-gap: 16px;
			max-width: 560px;
			margin: 0 auto;
		}

		.footer__nav li {
			justify-content: center;
		}

		.footer__nav li + li::before {
			display: none;
		}

		.footer__nav a {
			padding: 8px 4px;
			font-size: 15px;
		}
	}

	@media (max-width: 600px) {
		.footer__content {
			padding: calc(4.75rem + 16px) 16px 0;
		}

		.footer__nav ul {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			max-width: 320px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer__nav a::after {
			transition: none;
		}
	}
</style>

<script>
	function bindMeridianFooter() {
		const year = document.getElementById('year');
		if (year) year.textContent = String(new Date().getFullYear());

		const video = document.querySelector('.footer__video');
		if (!(video instanceof HTMLVideoElement) || video.dataset.bound === '1') return;
		video.dataset.bound = '1';

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			video.removeAttribute('autoplay');
			video.pause();
			return;
		}

		if (!('IntersectionObserver' in window)) return;
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) video.play().catch(() => {});
					else video.pause();
				}
			},
			{ threshold: 0.15 },
		);
		observer.observe(video);
	}

	bindMeridianFooter();
	document.addEventListener('astro:page-load', bindMeridianFooter);
</script>
