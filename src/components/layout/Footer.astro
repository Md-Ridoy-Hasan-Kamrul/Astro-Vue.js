---
/**
 * Site footer. Copy and links stay the site's own.
 * Motion matches Interactive Footer 6: a left-growing underline on each
 * link, and the wordmark reflected in water.
 */
import Icon from '../ui/Icon.vue';
import FooterNewsletter from '../islands/FooterNewsletter.vue';
import FooterWaterWordmark from '../islands/FooterWaterWordmark.vue';

const year = new Date().getFullYear();

const workLinks = [
	{ href: '/#partner', label: 'Partner' },
	{ href: '/#showcase', label: 'Showcase' },
	{ href: '/#orbit-projects', label: 'Motion' },
	{ href: '/#capabilities', label: 'Capabilities' },
];

const studioLinks = [
	{ href: '/#specialists', label: 'Specialists' },
	{ href: '/#client-stories', label: 'Clients' },
	{ href: '/#faq', label: 'FAQ' },
];

const visitLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/contact', label: 'Contact' },
];

const socialLinks = [
	{ href: '/', label: 'Home', icon: 'layers' as const },
	{ href: '/#faq', label: 'FAQ', icon: 'book' as const },
	{ href: '/contact', label: 'Contact', icon: 'mail' as const },
];

---

<footer class="relative bg-[#111b1d] text-[#ece9df]" aria-label="Site" data-maree>
	<div class="relative mx-auto w-[min(100%-2rem,72rem)]">
	<nav
		class="grid grid-cols-2 gap-x-5 gap-y-7 px-6 pt-9 min-[1020px]:flex min-[1020px]:items-start min-[1020px]:justify-between min-[1020px]:gap-7 min-[1020px]:px-8 min-[1020px]:pt-10 min-[1132px]:px-14 min-[1132px]:pt-11"
		aria-label="Footer"
	>
		<div class="col-span-2 flex w-full max-w-none flex-col gap-3 min-[1020px]:col-span-1 min-[1020px]:max-w-sm">
			<p class="m-0 inline-flex items-center gap-2 font-display text-[1.35rem] font-extrabold tracking-tight text-[#ece9df]">
				<Icon name="layers" class="size-5 text-sea" />
				Astro Vue
			</p>
			<p class="m-0 max-w-xs text-[0.9375rem] leading-snug text-[#aab5af]">
				Digital product design and development. Strategy, experience, and technology built for
				growth.
			</p>
			<FooterNewsletter client:visible />
		</div>

		<div class="flex flex-col gap-3">
			<p class="footer-heading">Work</p>
			<div class="flex flex-col gap-0.5">
				{
					workLinks.map((link) => (
						<a href={link.href} class="footer-link">
							<span class="footer-link-label">{link.label}</span>
							<span class="footer-underline" aria-hidden="true"></span>
						</a>
					))
				}
			</div>
		</div>
		<div class="flex flex-col gap-3">
			<p class="footer-heading">Studio</p>
			<div class="flex flex-col gap-0.5">
				{
					studioLinks.map((link) => (
						<a href={link.href} class="footer-link">
							<span class="footer-link-label">{link.label}</span>
							<span class="footer-underline" aria-hidden="true"></span>
						</a>
					))
				}
			</div>
		</div>
		<div class="flex flex-col gap-3">
			<p class="footer-heading">Visit</p>
			<div class="flex flex-col gap-0.5">
				{
					visitLinks.map((link) => (
						<a href={link.href} class="footer-link">
							<span class="footer-link-label">{link.label}</span>
							<span class="footer-underline" aria-hidden="true"></span>
						</a>
					))
				}
			</div>
		</div>
	</nav>

	<FooterWaterWordmark client:visible text="Astro Vue" />

	<div
		class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex flex-wrap items-center justify-between gap-5 px-6 pb-5 min-[1020px]:gap-6 min-[1020px]:px-8 min-[1020px]:pb-[18px] min-[1132px]:px-14 min-[1132px]:pb-5"
	>
		<a href="/" class="footer-link footer-link-sm pointer-events-auto">
			<span class="footer-link-label">© {year} Astro Vue</span>
			<span class="footer-underline" aria-hidden="true"></span>
		</a>
		<nav class="pointer-events-auto flex flex-wrap gap-2" aria-label="Social">
			{
				socialLinks.map((item) => (
					<a
						href={item.href}
						aria-label={item.label}
						class="grid size-10 place-items-center rounded-full border border-[#ece9df]/25 text-[#ece9df] transition hover:-translate-y-px hover:border-[#ece9df]/50"
						target={item.href.startsWith('http') ? '_blank' : undefined}
						rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
					>
						<Icon name={item.icon} class="size-4" />
					</a>
				))
			}
		</nav>
	</div>
	</div>
</footer>

<style>
	@font-face {
		font-family: 'Instrument Serif';
		font-style: italic;
		font-weight: 400;
		font-display: swap;
		src: url('https://fonts.gstatic.com/s/instrumentserif/v5/jizHRFtNs2ka5fXjeivQ4LroWlx-6zAjjH7M.woff2')
			format('woff2');
	}

	.footer-heading {
		margin: 0;
		font-family: 'Instrument Serif', 'Times New Roman', serif;
		font-style: italic;
		font-weight: 400;
		font-size: 19px;
		line-height: 24px;
		letter-spacing: 0;
		color: #ece9df;
	}

	.footer-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		height: 28px;
		padding: 0 1px;
		color: #aab5af;
		text-decoration: none;
		background: transparent;
		transition: color 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.footer-link-sm {
		height: 24px;
	}

	.footer-link-label {
		font-size: 14px;
		line-height: 22px;
		letter-spacing: -0.15px;
		transition: color 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.footer-link-sm .footer-link-label {
		font-size: 12px;
		line-height: 18px;
		letter-spacing: 0;
	}

	.footer-underline {
		position: absolute;
		right: 0;
		bottom: 2px;
		left: 0;
		height: 1px;
		background: #3de8ff;
		opacity: 1;
		transform: scaleX(0);
		transform-origin: 0% 50%;
		pointer-events: none;
		transition: transform 0.45s cubic-bezier(0.45, 0, 0.25, 1);
	}

	.footer-link:focus-visible {
		outline: 1px solid #ece9df;
		outline-offset: 3px;
		border-radius: 1px;
	}

	.footer-link:focus-visible > .footer-underline {
		transform: scaleX(1);
	}

	@media (hover: hover) and (pointer: fine) {
		.footer-link:hover > .footer-underline {
			transform: scaleX(1);
			transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.footer-link:hover,
		.footer-link:hover .footer-link-label {
			color: #fff;
		}
	}

	@media (max-width: 809.98px) {
		.footer-heading {
			font-size: 18px;
			line-height: 22px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-link,
		.footer-link *,
		.footer-underline,
		.footer-link:hover > .footer-underline {
			transition-duration: 0.001ms;
			animation-duration: 0.001ms;
		}
	}
</style>

<script>
	import { glideToElement, glideToY } from '../../lib/smoothScroll';

	function samePath(pathname: string) {
		const current = window.location.pathname.replace(/\/$/, '') || '/';
		const next = pathname.replace(/\/$/, '') || '/';
		return current === next;
	}

	function onFooterClick(event: MouseEvent) {
		const footer = (event.currentTarget as Element | null)?.closest?.('footer');
		const node = event.target;
		if (!(node instanceof Element) || !footer) return;
		const link = node.closest('a');
		if (!(link instanceof HTMLAnchorElement) || !footer.contains(link)) return;
		const url = new URL(link.href, window.location.href);
		if (url.origin !== window.location.origin) return;
		if (!samePath(url.pathname)) {
			if (!url.hash) return;
			event.preventDefault();
			event.stopPropagation();
			window.location.assign(`${url.pathname}${url.search}${url.hash}`);
			return;
		}

		const id = decodeURIComponent(url.hash.replace(/^#/, ''));
		if (!id) {
			event.preventDefault();
			event.stopPropagation();
			const search = window.location.search;
			if (window.location.hash) history.replaceState(null, '', `${url.pathname}${search}`);
			glideToY(0);
			return;
		}

		const target = document.getElementById(id);
		if (!target) return;
		event.preventDefault();
		event.stopPropagation();
		const nextHash = `#${id}`;
		if (window.location.hash !== nextHash) {
			history.replaceState(null, '', `${url.pathname}${window.location.search}${nextHash}`);
		}
		glideToElement(target);
	}

	function bindFooter() {
		const footer = document.querySelector('footer[aria-label="Site"]');
		if (!(footer instanceof HTMLElement) || footer.dataset.glideBound === 'true') return;
		footer.dataset.glideBound = 'true';
		footer.addEventListener('click', onFooterClick);
	}

	bindFooter();
	document.addEventListener('astro:page-load', bindFooter);
</script>
