---
import '../styles/global.css';
import '@fontsource-variable/figtree';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/space-mono/400.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/layout/Navbar.vue';
import SmoothScroll from '../components/islands/SmoothScroll.vue';

interface Props {
	title?: string;
	description?: string;
	/** Dark over hero; light on Contact / 404 / other pages. */
	navSurface?: 'dark' | 'light';
}

const {
	title = 'Astro Vue',
	description = 'Ship fast static pages with Astro and interactive islands with Vue.',
	navSurface = 'light',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const siteName = 'Astro Vue';
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="overflow-x-clip">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="overflow-x-clip">
		<SmoothScroll client:load transition:persist="site-lenis" />
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-sea focus:px-3 focus:py-2 focus:text-paper"
		>
			Skip to content
		</a>
		<Navbar
			client:load
			transition:persist="site-nav"
			surface={navSurface}
			currentPath={currentPath}
		/>
		<slot />
	</body>
</html>
